# Token da API da Apify (crie gratuitamente em https://console.apify.com/account/integrations)
APIFY_TOKEN=

# Actors da Apify utilizados na coleta automática
# Reels (padrão oficial da Apify para Reels de perfis públicos)
APIFY_REELS_ACTOR=apify~instagram-reel-scraper
# Stories (opcional: configure um actor de Stories da Apify se quiser capturar Stories automaticamente)
APIFY_STORIES_ACTOR=

# Chave da API do Gemini (Desconstrução IA + Geração de Vídeos com Gemini Omni 1.2 Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_OMNI_MODEL=gemini-omni-1.2-flash

# Chave da fal.ai (Studio de Vídeo: Seedance 2.0 + OmniHuman v2)
FAL_KEY=
FAL_OMNIHUMAN_MODEL=bytedance/omnihuman/v2
FAL_SEEDANCE_REF_MODEL=bytedance/seedance-2.0/reference-to-video
FAL_SEEDANCE_I2V_MODEL=bytedance/seedance-2.0/fast/image-to-video
FAL_SEEDANCE_T2V_MODEL=bytedance/seedance-2.0/fast/text-to-video

# Configurações do servidor local e coleta
PORT=3456
DEFAULT_MAX_ITEMS_PER_PROFILE=10
